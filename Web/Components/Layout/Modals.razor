@using Web.Services
@rendermode InteractiveServer
@inject UiStateService UiState

@switch (UiState.CurrentStep)
{
	case Modal.Register:
		<RegisterModal />
		break;
	case Modal.VerifyEmail:
		<VerifyEmailModal />
		break;
	case Modal.Login:
		<LoginModal />
		break;
}

<SettingsDrawer Login="true" />
<FilterDrawer />

@code {

	protected override void OnInitialized()
	{
		UiState.OnChange += HandleChange;
	}

	private void HandleChange() => InvokeAsync(StateHasChanged);

	public void Dispose()
	{
		UiState.OnChange -= HandleChange;
	}
}