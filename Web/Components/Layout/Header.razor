@using Web.Services
@rendermode InteractiveServer
@inject UiStateService UiState

<header class="topbar">
	<div class="topbar__inner">
		<a href="/" class="logo">Shopik<span class="logo__dot">.</span></a>

		<button type="button" class="btn-filter" @onclick="ShowFilter">
			<svg class="icon" viewBox="0 0 24 24">
				<line x1="4" y1="6" x2="20" y2="6" />
				<circle cx="9" cy="6" r="2" fill="currentColor" stroke="none" />
				<line x1="4" y1="12" x2="20" y2="12" />
				<circle cx="16" cy="12" r="2" fill="currentColor" stroke="none" />
				<line x1="4" y1="18" x2="20" y2="18" />
				<circle cx="11" cy="18" r="2" fill="currentColor" stroke="none" />
			</svg>
			<span class="btn-filter__text">Фільтр</span>
		</button>

		<form class="search" role="search">
			<input class="search__input" type="text" placeholder="Я шукаю..." />
			<button class="search__btn" type="submit" aria-label="Пошук">
				<svg class="icon" viewBox="0 0 24 24">
					<circle cx="11" cy="11" r="7" />
					<line x1="21" y1="21" x2="16.65" y2="16.65" />
				</svg>
			</button>
		</form>

		<div class="topbar__actions">

			<a href="/cart" class="icon-btn icon-btn--cart" aria-label="Кошик">
				<svg class="icon icon--lg" viewBox="0 0 24 24">
					<circle cx="9" cy="21" r="1.4" fill="currentColor" stroke="none" />
					<circle cx="19" cy="21" r="1.4" fill="currentColor" stroke="none" />
					<path d="M1.5 2h2.6l2.2 12.6a2.2 2.2 0 0 0 2.2 1.8h9.6a2.2 2.2 0 0 0 2.2-1.8L22 7H6" />
				</svg>
				@* <span class="icon-btn__badge">@cartCount</span> *@
			</a>

			@if (IsLogin)
			{
				<a href="/wishlist" class="icon-btn" id="wishlist" aria-label="Вподобання">
					<svg class="icon icon--lg" viewBox="0 0 24 24">
						<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
					</svg>
					@*<span class="icon-btn__badge">@wishlistCount</span> *@
				</a>
				<a href="/orders" class="icon-btn" id="orders" aria-label="Замовлення">
					<svg class="icon icon--lg" viewBox="0 0 24 24">
						<path d="M21 7.5 12 3 3 7.5 12 12l9-4.5z" />
						<path d="M3 7.5v9L12 21l9-4.5v-9" />
						<path d="M12 12v9" />
					</svg>
				</a>
			}
			else
			{
				<button type="button" class="link-action" @onclick="ShowLogin">
					<span class="full">Увійти</span>
				</button>
				<button type="button" class="link-action link-action--strong" @onclick="ShowRegister">
					<span class="full">Зареєструватися</span>
				</button>
				<button type="button" class="icon-btn icon-btn--guest" aria-label="Увійти або зареєструватися">
					<svg class="icon" viewBox="0 0 24 24">
						<circle cx="12" cy="8" r="3.6" />
						<path d="M4.5 20c0-4 3.4-6.5 7.5-6.5s7.5 2.5 7.5 6.5" />
					</svg>
				</button>
			}

			<button type="button" class="icon-btn" aria-label="Меню" @onclick="ShowSettings">
				<svg class="icon" id="settings" viewBox="0 0 24 24">
					<line x1="3" y1="6" x2="21" y2="6" />
					<line x1="3" y1="12" x2="21" y2="12" />
					<line x1="3" y1="18" x2="21" y2="18" />
				</svg>
			</button>
		</div>
	</div>
</header>

@code {
	[Parameter]
	public bool IsLogin { get; set; }

	private void ShowFilter() => UiState.Show(Modal.Filter);
	private void ShowLogin() => UiState.Show(Modal.Login);
	private void ShowRegister() => UiState.Show(Modal.Register);
	private void ShowSettings() => UiState.Show(Modal.Settings);
}
