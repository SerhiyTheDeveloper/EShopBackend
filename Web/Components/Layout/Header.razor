@using Microsoft.AspNetCore.Components.Authorization
@using Web.Services
@rendermode InteractiveServer
@implements IDisposable
@inject UiStateService UiState
@inject ProductFilterService Filter
@inject NavigationManager Nav
@inject WishListStateService Wish

<header class="topbar">
	<div class="topbar__inner">
		<a href="/" class="logo">Shopik<span class="logo__dot">.</span></a>

		<button type="button" class="btn-filter" @onclick="ShowFilter">
			<svg class="icon" viewBox="0 0 24 24">
				<line x1="4" y1="6" x2="20" y2="6" />
				<circle cx="9" cy="6" r="2" fill="currentColor" stroke="none" />
				<line x1="4" y1="12" x2="20" y2="12" />
				<circle cx="16" cy="12" r="2" fill="currentColor" stroke="none" />
				<line x1="4" y1="18" x2="20" y2="18" />
				<circle cx="11" cy="18" r="2" fill="currentColor" stroke="none" />
			</svg>
			<span class="btn-filter__text">Фільтр</span>
			@if (Filter.Applied.ActiveCount > 0)
			{
				<span class="btn-filter__count" aria-label="Активних фільтрів: @Filter.Applied.ActiveCount">@Filter.Applied.ActiveCount</span>
			}
		</button>

		<form class="search" role="search" @onsubmit="SubmitSearch" @onsubmit:preventDefault>
			<input class="search__input" type="text" placeholder="Я шукаю..." aria-label="Пошук товарів" autocomplete="off"
				   role="combobox" aria-autocomplete="list" aria-expanded="@isSuggestOpen"
				   @bind="searchText" @bind:event="oninput" @bind:after="OnSearchInput"
				   @onfocus="OpenSuggestions" @onblur="CloseSuggestions" @onkeydown="OnSearchKeyDown" />
			<button class="search__btn" type="submit" aria-label="Пошук">
				<svg class="icon" viewBox="0 0 24 24">
					<circle cx="11" cy="11" r="7" />
					<line x1="21" y1="21" x2="16.65" y2="16.65" />
				</svg>
			</button>

			@if (isSuggestOpen && searchText.Trim().Length > 0)
			{
				var suggestions = Suggestions;
				<ul class="search-suggest" role="listbox">
					@if (!Filter.IsLoaded)
					{
						<li class="search-suggest__empty">Завантаження...</li>
					}
					else if (suggestions.Count == 0)
					{
						<li class="search-suggest__empty">Нічого не знайдено</li>
					}
					else
					{
						@for (var i = 0; i < suggestions.Count; i++)
						{
							var product = suggestions[i];
							var index = i;
							<li role="option" aria-selected="@(index == highlight)"
								class="search-suggest__item @(index == highlight ? "search-suggest__item--active" : "")"
								@onmousedown="() => PickSuggestion(product)" @onmousedown:preventDefault
								@onmouseenter="() => highlight = index">
								<span class="search-suggest__name">@product.Name</span>
								<span class="search-suggest__meta">@product.Category · @product.Producer</span>
							</li>
						}
					}
				</ul>
			}
		</form>

		<div class="topbar__actions">

			<a href="/cart" class="icon-btn icon-btn--cart" aria-label="Кошик">
				<svg class="icon icon--lg" viewBox="0 0 24 24">
					<circle cx="9" cy="21" r="1.4" fill="currentColor" stroke="none" />
					<circle cx="19" cy="21" r="1.4" fill="currentColor" stroke="none" />
					<path d="M1.5 2h2.6l2.2 12.6a2.2 2.2 0 0 0 2.2 1.8h9.6a2.2 2.2 0 0 0 2.2-1.8L22 7H6" />
				</svg>
				@* <span class="icon-btn__badge">@cartCount</span> *@
			</a>

			<AuthorizeView>
				<Authorized>
					@* іконки вподобань і замовлень *@
					<a href="/account/wishlist" class="icon-btn" id="wishlist" aria-label="Вподобання">
						<svg class="icon icon--lg" viewBox="0 0 24 24">
							<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
						</svg>
						@if (Wish.Count > 0)
						{
							<span class="icon-btn__badge">@Wish.Count</span>
						}
					</a>
					<a href="/orders" class="icon-btn" id="orders" aria-label="Замовлення">
						<svg class="icon icon--lg" viewBox="0 0 24 24">
							<path d="M21 7.5 12 3 3 7.5 12 12l9-4.5z" />
							<path d="M3 7.5v9L12 21l9-4.5v-9" />
							<path d="M12 12v9" />
						</svg>
					</a>
				</Authorized>
				<NotAuthorized>
					@* кнопки Увійти / Зареєструватися та іконка-людинка для мобільного *@
					<button type="button" class="link-action" @onclick="ShowLogin">
						<span class="full">Увійти</span>
					</button>
					<button type="button" class="link-action link-action--strong" @onclick="ShowRegister">
						<span class="full">Зареєструватися</span>
					</button>
					<button type="button" class="icon-btn icon-btn--guest" aria-label="Увійти або зареєструватися">
						<svg class="icon" viewBox="0 0 24 24">
							<circle cx="12" cy="8" r="3.6" />
							<path d="M4.5 20c0-4 3.4-6.5 7.5-6.5s7.5 2.5 7.5 6.5" />
						</svg>
					</button>
				</NotAuthorized>
			</AuthorizeView>

			<button type="button" class="icon-btn" aria-label="Меню" @onclick="ShowSettings">
				<svg class="icon" id="settings" viewBox="0 0 24 24">
					<line x1="3" y1="6" x2="21" y2="6" />
					<line x1="3" y1="12" x2="21" y2="12" />
					<line x1="3" y1="18" x2="21" y2="18" />
				</svg>
			</button>
		</div>
	</div>
</header>

@code {
	private const int MaxSuggestions = 6;

	private string searchText = string.Empty;
	private string? lastAppliedSearch;
	private bool isSuggestOpen;
	private int highlight = -1;

	// Підказки: товари, що підходять під введений текст (ті самі правила, що й у пошуку); спершу ті, що починаються з нього
	private IReadOnlyList<ProductResponse> Suggestions
	{
		get
		{
			var text = searchText.Trim();
			if (text.Length == 0 || !Filter.IsLoaded) return [];

			var matcher = new ProductFilter { Search = text };
			return Filter.Products
				.Where(matcher.Matches)
				.OrderByDescending(p => p.Name.StartsWith(text, StringComparison.OrdinalIgnoreCase))
				.ThenBy(p => p.Name)
				.Take(MaxSuggestions)
				.ToList();
		}
	}

	protected override void OnInitialized()
	{
		searchText = Filter.Applied.Search ?? string.Empty;
		lastAppliedSearch = Filter.Applied.Search;
		Filter.OnChange += HandleFilterChange;
		Wish.OnChange += HandleWishChange;
	}

	// Список вподобань завантажується один раз на circuit (для гостя нічого не робиться)
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender) await Wish.EnsureLoadedAsync();
	}

	private void HandleWishChange() => InvokeAsync(StateHasChanged);

	private void HandleFilterChange()
	{
		// Поле оновлюємо лише коли застосований пошук справді змінився (× на головній, «Скинути все»),
		// інакше завантаження каталогу чи зміна фільтра стерли б текст, який користувач ще вводить
		if (Filter.Applied.Search != lastAppliedSearch)
		{
			lastAppliedSearch = Filter.Applied.Search;
			searchText = lastAppliedSearch ?? string.Empty;
		}

		InvokeAsync(StateHasChanged);
	}

	// Під час введення лише показуємо підказки, список на головній не змінюється
	private void OnSearchInput()
	{
		isSuggestOpen = true;
		highlight = -1;
		_ = Filter.EnsureLoadedAsync();
	}

	private void OpenSuggestions()
	{
		isSuggestOpen = true;
		_ = Filter.EnsureLoadedAsync();
	}

	private void CloseSuggestions()
	{
		isSuggestOpen = false;
		highlight = -1;
	}

	private void OnSearchKeyDown(KeyboardEventArgs e)
	{
		var count = Suggestions.Count;

		switch (e.Key)
		{
			case "ArrowDown":
				if (count > 0)
				{
					isSuggestOpen = true;
					highlight = (highlight + 1) % count;
				}
				break;
			case "ArrowUp":
				if (count > 0)
				{
					isSuggestOpen = true;
					highlight = highlight <= 0 ? count - 1 : highlight - 1;
				}
				break;
			case "Escape":
				CloseSuggestions();
				break;
		}
	}

	// Enter або кнопка з лупою: якщо підказку підсвічено стрілками, шукаємо її назву, інакше введений текст
	private void SubmitSearch()
	{
		var suggestions = Suggestions;
		if (isSuggestOpen && highlight >= 0 && highlight < suggestions.Count)
		{
			searchText = suggestions[highlight].Name;
		}

		ApplySearch();
	}

	private void PickSuggestion(ProductResponse product)
	{
		searchText = product.Name;
		ApplySearch();
	}

	private void ApplySearch()
	{
		Filter.SetSearch(searchText);
		CloseSuggestions();

		// Результати видно на головній: якщо шукали з іншої сторінки, переходимо туди
		if (new Uri(Nav.Uri).AbsolutePath != "/") Nav.NavigateTo("/");
	}

	public void Dispose()
	{
		Filter.OnChange -= HandleFilterChange;
		Wish.OnChange -= HandleWishChange;
	}

	private void ShowFilter() => UiState.Show(Modal.Filter);
	private void ShowLogin() => UiState.Show(Modal.Login);
	private void ShowRegister() => UiState.Show(Modal.Register);
	private void ShowSettings() => UiState.Show(Modal.Settings);
}
