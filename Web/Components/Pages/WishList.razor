@page "/account/wishlist"
@rendermode InteractiveServer
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@inject WishListStateService Wish
@inject UiStateService UiState

<PageTitle>Shopik — Вподобання</PageTitle>

<AuthorizeView Context="auth">
	<Authorized>
		<main class="container">
			@PageHead(Wish.IsLoaded && Wish.Count > 0 ? CountText : null)

			<section style="padding-top:6px;">
				@if (!Wish.IsLoaded)
				{
					<div class="loading">Завантаження...</div>
				}
				else if (Wish.Count == 0)
				{
					<EmptyState Icon="EmptyState.EmptyStateIcon.Heart" Title="У вподобаннях поки порожньо"
								Description="Натисніть на серце біля товару, і він з'явиться тут.">
						<a href="/" class="btn btn--primary">До каталогу</a>
					</EmptyState>
				}
				else
				{
					<div class="product-grid">
						@foreach (var product in Wish.Products.ToList())
						{
							<ProductCard Product="product" />
						}
					</div>
				}
			</section>
		</main>
	</Authorized>
	<NotAuthorized>
		<main class="container">
			@PageHead(null)

			<section style="padding-top:6px;">
				<EmptyState Icon="EmptyState.EmptyStateIcon.Heart" Title="Увійдіть, щоб бачити вподобання"
							Description="Збережені товари доступні після входу в акаунт.">
					<button type="button" class="btn btn--primary" @onclick="ShowLogin">Увійти</button>
				</EmptyState>
			</section>
		</main>
	</NotAuthorized>
</AuthorizeView>

@code {
	private RenderFragment PageHead(string? subtitle) => @<div class="page-head">
		<div class="breadcrumb">
			<a href="/">Головна</a>
			<svg class="icon" viewBox="0 0 24 24"><polyline points="9 6 15 12 9 18"></polyline></svg>
			<span>Вподобання</span>
		</div>
		<h1>Вподобання</h1>
		@if (subtitle is not null)
		{
			<p class="page-head__sub">@subtitle</p>
		}
	</div>;

	private string CountText => $"{Wish.Count} {UkrainianPlural.Goods(Wish.Count)}, які ви зберегли";

	protected override void OnInitialized() => Wish.OnChange += HandleWishChange;

	// Напряму відкрити сторінку теж можна: список завантажується й тут (спільний запит із шапкою)
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!firstRender) return;

		await Wish.EnsureLoadedAsync();
		StateHasChanged();
	}

	private void HandleWishChange() => InvokeAsync(StateHasChanged);

	private void ShowLogin() => UiState.Show(Modal.Login);

	public void Dispose() => Wish.OnChange -= HandleWishChange;
}
