@page "/account/wishlist"
@rendermode InteractiveServer
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@inject WishListStateService Wish
@inject UiStateService UiState

<PageTitle>Shopik — Вподобання</PageTitle>

<main class="container">
	<div class="page-head">
		<div class="breadcrumb">
			<a href="/">Головна</a>
			<svg class="icon" viewBox="0 0 24 24"><polyline points="9 6 15 12 9 18"></polyline></svg>
			<span>Вподобання</span>
		</div>
		<h1>Вподобання</h1>
		<AuthorizeView Context="auth">
			<Authorized>
				@if (Wish.IsLoaded)
				{
					<p class="page-head__sub">@CountText</p>
				}
			</Authorized>
		</AuthorizeView>
	</div>

	<section style="padding-top:6px;">
		<AuthorizeView Context="auth">
			<Authorized>
				@if (!Wish.IsLoaded)
				{
					<div class="loading">Завантаження...</div>
				}
				else if (Wish.Count == 0)
				{
					<div class="empty">
						<p>У вподобаннях поки порожньо.</p>
						<p class="settings-card__desc">Натисніть на серце біля товару, щоб зберегти його тут.</p>
						<a href="/" class="btn btn--primary btn--sm" style="margin-top:12px;">До каталогу</a>
					</div>
				}
				else
				{
					<div class="product-grid">
						@foreach (var product in Wish.Products.ToList())
						{
							<ProductCard Product="product" />
						}
					</div>
				}
			</Authorized>
			<NotAuthorized>
				<div class="empty">
					<p>Увійдіть, щоб бачити збережені товари.</p>
					<button type="button" class="btn btn--primary btn--sm" style="margin-top:12px;" @onclick="ShowLogin">Увійти</button>
				</div>
			</NotAuthorized>
		</AuthorizeView>
	</section>
</main>

@code {
	private string CountText => $"{Wish.Count} {Plural(Wish.Count)}, які ви зберегли";

	// Укр. відмінювання: 1 товар, 2-4 товари, 5-20 товарів, 21 товар...
	private static string Plural(int count)
	{
		var lastTwo = count % 100;
		var last = count % 10;

		if (lastTwo is >= 11 and <= 14) return "товарів";
		return last switch
		{
			1 => "товар",
			>= 2 and <= 4 => "товари",
			_ => "товарів"
		};
	}

	protected override void OnInitialized() => Wish.OnChange += HandleWishChange;

	// Напряму відкрити сторінку теж можна: список завантажується й тут (спільний запит із шапкою)
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!firstRender) return;

		await Wish.EnsureLoadedAsync();
		StateHasChanged();
	}

	private void HandleWishChange() => InvokeAsync(StateHasChanged);

	private void ShowLogin() => UiState.Show(Modal.Login);

	public void Dispose() => Wish.OnChange -= HandleWishChange;
}
