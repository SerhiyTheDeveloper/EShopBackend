@page "/"
@implements IDisposable
@using System.Globalization
@using Web.Services
@inject ProductFilterService Filter
@rendermode InteractiveServer

<PageTitle>Shopik - інтернет-магазин електроніки</PageTitle>

<main class="container">
	<div class="page-head" style="padding-bottom:0;">
		<h1 style="font-size:24px;">Рекомендовані товари</h1>
	</div>

	<section style="padding-top:18px;">
		@{ var filtered = Filter.Filtered.ToList(); }
		@if (Filter.Applied.IsActive)
		{
			<div class="active-filters">
				@if (Filter.Applied.HasPrice)
				{
					<button type="button" class="filter-tag" @onclick="Filter.RemovePrice" aria-label="Прибрати фільтр за ціною">
						@PriceText <span class="filter-tag__x">×</span>
					</button>
				}
				@if (Filter.Applied.Category is not null)
				{
					<button type="button" class="filter-tag" @onclick="Filter.RemoveCategory" aria-label="Прибрати фільтр за категорією">
						@Filter.Applied.Category <span class="filter-tag__x">×</span>
					</button>
				}
				@foreach (var brand in Filter.Applied.Brands.OrderBy(b => b))
				{
					<button type="button" class="filter-tag" @onclick="() => Filter.RemoveBrand(brand)" aria-label="Прибрати бренд @brand">
						@brand <span class="filter-tag__x">×</span>
					</button>
				}
				<button type="button" class="filter-tag filter-tag--reset" @onclick="Filter.Reset">Скинути все</button>
			</div>
		}

		@if (!Filter.IsLoaded && Filter.LoadError is null)
		{
			<div class="loading">Завантаження товарів...</div>
		}
		else if (!Filter.IsLoaded)
		{
			<div class="empty">
				<p>@Filter.LoadError</p>
				<button type="button" class="btn btn--outline btn--sm" style="margin-top:12px;" @onclick="Filter.ReloadAsync">Спробувати ще раз</button>
			</div>
		}
		else if (Filter.Products.Count == 0)
		{
			<div class="empty">Товарів не знайдено.</div>
		}
		else if (filtered.Count == 0)
		{
			<div class="empty">
				<p>За вибраними умовами нічого не знайдено.</p>
				<button type="button" class="btn btn--outline btn--sm" style="margin-top:12px;" @onclick="Filter.Reset">Скинути фільтр</button>
			</div>
		}
		else
		{
			<div class="product-grid">
				@foreach (var product in filtered)
				{
					<article class="product-card">
						<button class="product-card__wish" aria-label="Додати до вподобань">
							<svg class="icon icon--sm" viewBox="0 0 24 24">
								<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
							</svg>
						</button>
						<div class="product-card__media product-card__media--tall @(HasImage(product) ? "product-card__media--has-image" : "")">
							<span class="product-card__blob"></span>
							<svg class="icon" viewBox="0 0 24 24"><rect x="7" y="2" width="10" height="20" rx="2.4"></rect><line x1="10.5" y1="18.3" x2="13.5" y2="18.3"></line></svg>
							@if (HasImage(product))
							{
								@* Якщо картинка не завантажилась, прибираємо клас has-image: CSS ховає <img> і повертає заглушку *@
								<img class="product-card__img" src="@product.ImageUrl" alt="@product.Name"
									 loading="lazy" referrerpolicy="no-referrer"
									 onerror="this.parentElement.classList.remove('product-card__media--has-image')" />
							}
						</div>
						<p class="product-card__category">@product.Category</p>
						<h3 class="product-card__title">@product.Name</h3>
						<div class="product-card__price-row">
							<span class="price">@product.Price ₴</span>
						</div>
						<button class="btn-add">У кошик</button>
					</article>
				}
			</div>
		}
	</section>
</main>

@code{
	private string PriceText
	{
		get
		{
			var applied = Filter.Applied;
			var from = applied.MinPrice?.ToString("0.##", CultureInfo.InvariantCulture);
			var to = applied.MaxPrice?.ToString("0.##", CultureInfo.InvariantCulture);

			if (from is not null && to is not null) return $"Ціна: {from}–{to} ₴";
			return from is not null ? $"Ціна: від {from} ₴" : $"Ціна: до {to} ₴";
		}
	}

	private static bool HasImage(ProductResponse product) => !string.IsNullOrWhiteSpace(product.ImageUrl);

	protected override async Task OnInitializedAsync()
	{
		Filter.OnChange += HandleChange;
		await Filter.EnsureLoadedAsync();
	}

	private void HandleChange() => InvokeAsync(StateHasChanged);

	public void Dispose()
	{
		Filter.OnChange -= HandleChange;
	}
}
