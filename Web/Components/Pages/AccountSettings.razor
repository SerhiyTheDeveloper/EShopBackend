@page "/account"
@rendermode InteractiveServer
@using MINT.EShop.Business.DTOs.Identity
@using Microsoft.AspNetCore.Components.Authorization
@inject UserProfileService Profile

<PageTitle>Shopik — Налаштування акаунта</PageTitle>

<main class="container">
	<div class="settings-page">
		<div class="page-head">
			<div class="breadcrumb">
				<a href="/">Головна</a>
				<svg class="icon" viewBox="0 0 24 24"><polyline points="9 6 15 12 9 18" /></svg>
				<span>Налаштування акаунта</span>
			</div>
			<h1>Налаштування акаунта</h1>
			<p class="page-head__sub">Керуйте особистою інформацією та виглядом застосунку.</p>
		</div>

		<div class="settings-shell">
			<AuthorizeView Context="auth">
				<Authorized>
					<div class="settings-card">
						<h2>Особиста інформація</h2>
						<p class="settings-card__desc">Ці дані бачить тільки ви та служба підтримки Shopik.</p>

						@if (isLoading)
						{
							<p class="settings-card__desc">Завантаження...</p>
						}
						else if (Profile.User is null)
						{
							<p class="field__error">@(loadError ?? "Не вдалося завантажити дані акаунта.")</p>
							<div class="settings-card__actions">
								<button type="button" class="btn btn--outline" @onclick="Reload">Спробувати ще раз</button>
							</div>
						}
						else
						{
							<EditForm Model="model" OnValidSubmit="Save" novalidate>
								<DataAnnotationsValidator />

								<div class="settings-grid">
									<div class="field">
										<label class="field__label" for="set-name">Ім'я</label>
										<InputText class="input" id="set-name" @bind-Value="model.FirstName" />
										<ValidationMessage For="() => model.FirstName" class="field__error" />
									</div>
									<div class="field">
										<label class="field__label" for="set-surname">Прізвище</label>
										<InputText class="input" id="set-surname" @bind-Value="model.LastName" />
										<ValidationMessage For="() => model.LastName" class="field__error" />
									</div>
									<div class="field">
										<label class="field__label" for="set-phone">Номер телефону</label>
										<div class="phone-wrap">
											<input class="phone-code" type="text" value="+380" readonly aria-label="Код країни" />
											<InputText class="input" id="set-phone" type="tel" @bind-Value="model.Phone" />
										</div>
										<ValidationMessage For="() => model.Phone" class="field__error" />
									</div>
									<div class="field">
										<label class="field__label" for="set-email">Електронна пошта</label>
										<input class="input input--readonly" id="set-email" type="email"
											   value="@Profile.User.Email" readonly />
										<p class="field__hint field__hint--lock">
											<svg class="icon icon--sm" viewBox="0 0 24 24">
												<rect x="5" y="11" width="14" height="9" rx="2" />
												<path d="M8 11V7a4 4 0 0 1 8 0v4" />
											</svg>
											Пошту не можна змінити
										</p>
									</div>
								</div>

								@if (!string.IsNullOrEmpty(saveError))
								{
									<p class="field__error" style="margin-top:14px;">@saveError</p>
								}
								@if (!string.IsNullOrEmpty(successMessage))
								{
									<p class="field__hint" style="margin-top:14px;">@successMessage</p>
								}

								<div class="settings-card__actions">
									<button type="button" class="btn btn--outline" @onclick="Cancel" disabled="@isSaving">Скасувати</button>
									<button type="submit" class="btn btn--primary" disabled="@isSaving">
										@if (isSaving)
										{
											<span>Зачекайте...</span>
										}
										else
										{
											<span>Зберегти зміни</span>
										}
									</button>
								</div>
							</EditForm>
						}
					</div>
				</Authorized>
				<NotAuthorized>
					<div class="settings-card">
						<h2>Особиста інформація</h2>
						<p class="settings-card__desc">Увійдіть в акаунт, щоб переглядати та змінювати свої дані.</p>
					</div>
				</NotAuthorized>
			</AuthorizeView>

			<div class="settings-card">
				<h2>Тема оформлення</h2>
				<p class="settings-card__desc">Світла тема вже доступна. Темна — у розробці.</p>

				<div class="theme-toggle">
					<div class="theme-option theme-option--active">
						<div class="theme-option__check">
							<svg class="icon icon--sm" viewBox="0 0 24 24">
								<polyline points="4 12 9 17 20 6" />
							</svg>
						</div>
						<div class="theme-option__icon">
							<svg class="icon" viewBox="0 0 24 24">
								<circle cx="12" cy="12" r="4.2" />
								<line x1="12" y1="2" x2="12" y2="4.5" />
								<line x1="12" y1="19.5" x2="12" y2="22" />
								<line x1="4.2" y1="4.2" x2="6" y2="6" />
								<line x1="18" y1="18" x2="19.8" y2="19.8" />
								<line x1="2" y1="12" x2="4.5" y2="12" />
								<line x1="19.5" y1="12" x2="22" y2="12" />
								<line x1="4.2" y1="19.8" x2="6" y2="18" />
								<line x1="18" y1="6" x2="19.8" y2="4.2" />
							</svg>
						</div>
						<div class="theme-option__title">Світла</div>
						<div class="theme-option__sub">Активна тема</div>
						<div class="theme-preview">
							<span class="a"></span><span class="b"></span><span class="b"></span>
						</div>
					</div>

					<button type="button" class="theme-option" style="opacity:.6; background:none; border:1.5px solid var(--line-200); border-radius:var(--radius-md); cursor:default;">
						<div class="theme-option__icon">
							<svg class="icon" viewBox="0 0 24 24">
								<path d="M20 14.5a8.5 8.5 0 1 1-9-12 7 7 0 0 0 9 12z" />
							</svg>
						</div>
						<div class="theme-option__title">Темна</div>
						<div class="theme-option__sub">Скоро з'явиться</div>
						<div class="theme-preview theme-preview--dark">
							<span class="a"></span><span class="b"></span><span class="b"></span>
						</div>
					</button>
				</div>
			</div>
		</div>
	</div>
</main>

@code {
	private readonly AccountSettingsModel model = new();
	private bool isLoading = true;
	private bool isSaving;
	private string? loadError;
	private string? saveError;
	private string? successMessage;

	protected override async Task OnInitializedAsync()
	{
		// force: щоб на сторінці завжди були актуальні дані, а не кеш із SettingsDrawer
		loadError = await Profile.LoadAsync(force: true);
		FillModel();
		isLoading = false;
	}

	private async Task Reload()
	{
		isLoading = true;
		loadError = await Profile.LoadAsync(force: true);
		FillModel();
		isLoading = false;
	}

	private void FillModel()
	{
		var user = Profile.User;
		if (user is null) return;

		model.FirstName = user.FirstName;
		model.LastName = user.LastName ?? string.Empty;
		model.Phone = user.PhoneNumber;
	}

	private void Cancel()
	{
		FillModel();
		saveError = null;
		successMessage = null;
	}

	private async Task Save()
	{
		if (isSaving) return;
		isSaving = true;
		saveError = null;
		successMessage = null;

		var request = new UpdateUserDataRequest
		{
			FirstName = model.FirstName.Trim(),
			LastName = string.IsNullOrWhiteSpace(model.LastName) ? null : model.LastName.Trim(),
			PhoneNumber = model.Phone.Trim()
		};

		saveError = await Profile.UpdateAsync(request);
		if (saveError is null)
		{
			successMessage = "Зміни збережено.";
			FillModel();
		}

		isSaving = false;
	}
}
