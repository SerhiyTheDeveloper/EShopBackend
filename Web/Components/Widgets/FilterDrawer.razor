@implements IDisposable
@using System.Globalization
@inject UiStateService UiState
@inject ProductFilterService Filter
@inject NavigationManager Nav

<div class="sidepanel-overlay @(isOpen ? "active" : "")" @onclick="Close">
    <aside class="drawer drawer--left @(isOpen ? "open" : "")" @onclick:stopPropagation="true">
        <div class="drawer__filter-head">
            <h3>Фільтр товарів</h3>
            <button type="button" class="drawer__close" aria-label="Закрити" @onclick="Close">
                <svg class="icon" viewBox="0 0 24 24">
                    <line x1="6" y1="6" x2="18" y2="18" />
                    <line x1="18" y1="6" x2="6" y2="18" />
                </svg>
            </button>
        </div>

        <div class="drawer__filter-body">
            @if (!Filter.IsLoaded)
            {
                @if (Filter.LoadError is not null)
                {
                    <p class="field__error">@Filter.LoadError</p>
                    <button type="button" class="btn btn--outline btn--sm" @onclick="Filter.ReloadAsync">Спробувати ще раз</button>
                }
                else
                {
                    <p class="settings-card__desc">Завантаження...</p>
                }
            }
            else
            {
                <div class="filter-block">
                    <div class="filter-block__label">
                        <svg class="icon" viewBox="0 0 24 24">
                            <line x1="12" y1="1" x2="12" y2="23" />
                            <path d="M17 5.5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                        </svg>
                        Ціна, ₴
                    </div>
                    <div class="price-range">
                        <input class="input" type="number" min="0" step="100" placeholder="@MinPlaceholder" aria-label="Ціна від"
                               @bind="draft.MinPrice" @bind:event="oninput" />
                        <span class="price-range__sep">—</span>
                        <input class="input" type="number" min="0" step="100" placeholder="@MaxPlaceholder" aria-label="Ціна до"
                               @bind="draft.MaxPrice" @bind:event="oninput" />
                    </div>
                    @if (PriceInvalid)
                    {
                        <p class="field__error" style="margin-top:8px;">«Від» не може бути більшим за «до».</p>
                    }
                </div>

                <div class="filter-block">
                    <div class="filter-block__label">
                        <svg class="icon" viewBox="0 0 24 24">
                            <rect x="3" y="3" width="7" height="7" rx="1.4" />
                            <rect x="14" y="3" width="7" height="7" rx="1.4" />
                            <rect x="3" y="14" width="7" height="7" rx="1.4" />
                            <rect x="14" y="14" width="7" height="7" rx="1.4" />
                        </svg>
                        Категорія
                    </div>
                    <div class="brand-chip-grid filter-cats">
                        <button type="button" class="brand-chip @(draft.Category is null ? "brand-chip--active" : "")"
                                aria-pressed="@(draft.Category is null)" @onclick="() => SelectCategory(null)">
                            Усі <span class="brand-chip__count">@AllCategoriesCount</span>
                        </button>
                        @foreach (var category in Filter.Categories.OrderBy(c => c.Name))
                        {
                            var selected = IsSelectedCategory(category.Name);
                            var count = CategoryCount(category.Name);
                            <button type="button" class="brand-chip @(selected ? "brand-chip--active" : "")"
                                    aria-pressed="@selected" disabled="@(count == 0 && !selected)"
                                    @onclick="() => SelectCategory(category.Name)">
                                @category.Name <span class="brand-chip__count">@count</span>
                            </button>
                        }
                    </div>
                </div>

                <div class="filter-block">
                    <div class="filter-block__label">
                        <svg class="icon" viewBox="0 0 24 24">
                            <path d="M12 2l2.4 5 5.6.8-4 4 1 5.6L12 14.8 7 17.4l1-5.6-4-4 5.6-.8z" />
                        </svg>
                        Бренд
                    </div>
                    <div class="brand-chip-grid filter-cats">
                        @foreach (var brand in Filter.AllBrands())
                        {
                            var selected = draft.Brands.Contains(brand);
                            var count = BrandCount(brand);
                            <button type="button" class="brand-chip @(selected ? "brand-chip--active" : "")"
                                    aria-pressed="@selected" disabled="@(count == 0 && !selected)"
                                    @onclick="() => ToggleBrand(brand)">
                                @brand <span class="brand-chip__count">@count</span>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="drawer__filter-footer">
            <button type="button" class="btn btn--outline" @onclick="ResetDraft">Скинути</button>
            <button type="button" class="btn btn--primary" @onclick="Apply"
                    disabled="@(!Filter.IsLoaded || PriceInvalid || ResultCount == 0)">
                Показати @(Filter.IsLoaded ? $"({ResultCount})" : "")
            </button>
        </div>
    </aside>
</div>

@code {
    private bool isOpen => UiState.CurrentStep == Modal.Filter;
    private bool wasOpen;

    // Чернетка: змінюється в drawer, застосовується кнопкою «Показати», а закриття без неї її відкидає
    private ProductFilter draft = new();

    private bool PriceInvalid => draft.MinPrice.HasValue && draft.MaxPrice.HasValue && draft.MinPrice > draft.MaxPrice;

    private int ResultCount => Filter.Count(draft);

    private int AllCategoriesCount => Filter.Count(draft.WithoutCategory());

    private string MinPlaceholder => Filter.PriceBounds() is { } bounds ? $"від {Format(Math.Floor(bounds.Min))}" : "від 0";

    private string MaxPlaceholder => Filter.PriceBounds() is { } bounds ? $"до {Format(Math.Ceiling(bounds.Max))}" : "до";

    private static string Format(decimal value) => value.ToString("0", CultureInfo.InvariantCulture);

    protected override void OnInitialized()
    {
        UiState.OnChange += HandleUiChange;
        Filter.OnChange += HandleFilterChange;
    }

    private void HandleUiChange()
    {
        // Щойно відкрили: чернетка починається із застосованого фільтра, каталог завантажується за потреби
        if (isOpen && !wasOpen)
        {
            draft = Filter.Applied.Clone();
            _ = Filter.EnsureLoadedAsync();
        }

        wasOpen = isOpen;
        InvokeAsync(StateHasChanged);
    }

    private void HandleFilterChange() => InvokeAsync(StateHasChanged);

    private void Close() => UiState.Show(Modal.None);

    private bool IsSelectedCategory(string name)
        => draft.Category is not null && draft.Category.Equals(name, StringComparison.OrdinalIgnoreCase);

    // Лічильники враховують решту умов: категорії рахуються з урахуванням ціни та брендів
    private int CategoryCount(string name)
    {
        var filter = draft.WithoutCategory();
        return Filter.Products.Count(p => p.Category.Equals(name, StringComparison.OrdinalIgnoreCase) && filter.Matches(p));
    }

    // Бренди рахуються з урахуванням ціни та категорії
    private int BrandCount(string brand)
    {
        var filter = draft.WithoutBrands();
        return Filter.Products.Count(p => p.Producer.Equals(brand, StringComparison.OrdinalIgnoreCase) && filter.Matches(p));
    }

    private void SelectCategory(string? name)
        => draft.Category = name is not null && IsSelectedCategory(name) ? null : name;

    private void ToggleBrand(string brand)
    {
        if (!draft.Brands.Remove(brand)) draft.Brands.Add(brand);
    }

    // Пошуковий запит живе у шапці й має власне керування, тож «Скинути» його не чіпає
    private void ResetDraft() => draft = new ProductFilter { Search = draft.Search };

    private void Apply()
    {
        if (PriceInvalid) return;

        // Запит міг змінитися, поки drawer був відкритий
        draft.Search = Filter.Applied.Search;

        Filter.Apply(draft);
        UiState.Show(Modal.None);

        // Результат видно на головній: якщо фільтр застосували з іншої сторінки, переходимо туди
        var path = new Uri(Nav.Uri).AbsolutePath;
        if (path != "/") Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        UiState.OnChange -= HandleUiChange;
        Filter.OnChange -= HandleFilterChange;
    }
}
