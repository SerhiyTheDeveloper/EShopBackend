@inject UiStateService UiState

<div class="overlay">
    <div class="modal" @onclick:stopPropagation>
        <button type="button" class="modal__close" aria-label="Закрити" @onclick="Close">
            <svg class="icon" viewBox="0 0 24 24">
                <line x1="6" y1="6" x2="18" y2="18" />
                <line x1="18" y1="6" x2="6" y2="18" />
            </svg>
        </button>

        <h2 class="modal__title">Створити акаунт</h2>
        <p class="modal__subtitle-reg">Заповніть форму нижче — це займе одну хвилину.</p>
        <p class="modal__subtitle-reg__small">Заповніть форму нижче.</p>

        <div class="field">
            <label class="field__label" for="reg-email">Електронна пошта</label>
            <input class="input" id="reg-email" type="email" placeholder="user@gmail.com" />
        </div>

        <div class="field">
            <label class="field__label" for="reg-pass">Пароль</label>
            <div class="input-wrap">
                <input class="input input--with-icon" id="reg-pass" type="password" placeholder="Введіть пароль" />
                <button type="button" class="input-icon-btn" aria-label="Показати пароль">
                    <svg class="icon icon--sm" viewBox="0 0 24 24">
                        <path d="M1 12s4-7.5 11-7.5S23 12 23 12s-4 7.5-11 7.5S1 12 1 12z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                </button>
            </div>
            <p class="field__hint">Пароль щонайменше 8 символів.</p>
        </div>

        <div style="display:flex; gap:12px;">
            <div class="field" style="flex:1;">
                <label class="field__label" for="reg-name">Ім'я</label>
                <input class="input" id="reg-name" type="text" placeholder="Ім'я" />
            </div>
            <div class="field" style="flex:1;">
                <label class="field__label" for="reg-surname">Прізвище</label>
                <input class="input" id="reg-surname" type="text" placeholder="Прізвище" />
            </div>
        </div>

        <div class="field">
            <label class="field__label" for="reg-phone">Номер телефону</label>
            <div class="phone-wrap">
                <input class="phone-code" type="text" value="+380" readonly aria-label="Код країни" />
                <input class="input" id="reg-phone" type="tel" placeholder="00 000 00 00" />
            </div>
        </div>

        <button type="button" class="btn btn--primary btn--block" style="margin-top:6px;">
            Зареєструватися
        </button>

        <p class="modal__foot">
            Вже маєте акаунт?
            <button type="button" class="field__link"
                style="background:none;border:none;padding:0;color:var(--purple-600);font-weight:600;cursor:pointer;"
                    @onclick="ShowLogin"> 
                Увійти
            </button>
        </p>
    </div>
</div>

@code {
    [Parameter] public EventCallback<string> OnSubmit { get; set; }

    private RegisterModel model = new();

    private void Close() => UiState.Show(Modal.None);
    private void ShowLogin() => UiState.Show(Modal.Login);

    private async Task HandleSubmit()
    {
        // тут виклик твого API через HttpClient
    }

    public class RegisterModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string PhoneNumber { get; set; } = string.Empty;
    }
}
