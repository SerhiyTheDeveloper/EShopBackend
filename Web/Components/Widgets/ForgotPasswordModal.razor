@using MINT.EShop.Business.DTOs.Identity
@inject UiStateService UiState
@inject IJSRuntime JS

<div class="overlay" @onclick="Close">
    <div class="modal" @onclick:stopPropagation>
        <button class="modal__close" aria-label="Закрити" @onclick="Close">
            <svg class="icon" viewBox="0 0 24 24"><line x1="6" y1="6" x2="18" y2="18"></line><line x1="18" y1="6" x2="6" y2="18"></line></svg>
        </button>

        @if (step == 1)
        {
            <span class="modal__step">Крок 1 з 3</span>
            <h2 class="modal__title">Відновлення пароля</h2>
            <p class="modal__subtitle">Введіть пошту, на яку зареєстрований акаунт. Ми надішлемо код підтвердження.</p>

            <EditForm Model="model" OnSubmit="HandleEmailSubmit" novalidate>
				<DataAnnotationsValidator />
                <div class="field">
                    <label class="field__label" for="reg-email">Електронна пошта</label>
                    <InputText class="input" id="fp-email" type="email"
                               placeholder="user@gmail.com"
                               @bind-Value="model.Email" />
					<ValidationMessage For="() => model.Email" class="field__error" />
                </div>

                <button type="submit" class="btn btn--primary btn--block"
                        style="margin-top:6px;" disabled="@isProcessing">
                    @if (isProcessing)
                    {
                        <span>Надсилання...</span>
                    }
                    else
                    {
                        <span>Надіслати код</span>
                    }
                </button>
            </EditForm>

            <p class="modal__foot">
                Згадали пароль?
                <button type="button" class="field__link"
                        style="background:none;border:none;padding:0;color:var(--purple-600);font-weight:600;cursor:pointer;"
                        @onclick="ShowLogin">
                    Увійти
                </button>
            </p>
        }

        else if (step == 2)
        {
            <span class="modal__step">Крок 2 з 3</span>
            <h2 class="modal__title">Введіть код</h2>
            <p class="modal__subtitle">
                Код надіслано на <b>@model.Email</b>
            </p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <p class="field__error" style="margin-bottom:10px;">@errorMessage</p>
            }

            <div class="code-row">
                @for (int i = 0; i < 6; i++)
                {
                    var index = i;
                    <input class="@($"code-box{(digits[index] != "" ? " code-box--filled" : "")}")"
                           inputmode="numeric"
                           value="@digits[index]"
                           maxlength="1"
                           @ref="inputRefs[index]"
                           @oninput="e => HandleNumberInput(index, e)"
                           @onkeydown="e => HandleKeyDown(index, e)" />
                }
            </div>

            <button type="button" class="btn btn--primary btn--block"
                    style="margin-top:20px;"
                    disabled="@(isProcessing || digits.Any(d => string.IsNullOrWhiteSpace(d)))"
                    @onclick="HandleCodeSubmit">
                @(isProcessing ? "Перевірка..." : "Підтвердити та завершити")
            </button>

            <p class="modal__resend">
                Не отримали код?
                @if (cooldown > 0)
                {
                    <span style="color:var(--slate-300);">
                        Надіслати ще раз через 0:@cooldown.ToString("D2")
                    </span>
                }
                else
                {
                    <button type="button"
                            style="background:none;border:none;padding:0;color:var(--purple-600);font-weight:600;cursor:pointer;"
                            @onclick="ResentCode">
                        Надіслати ще раз
                    </button>
                }
            </p>
        }

        @* else if (step == 3)
        {
            <span class="modal__step">Крок 3 з 3</span>
            <h2 class="modal__title">Новий пароль</h2>
            <p class="modal__subtitle">Введіть новий пароль для акаунта.</p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <p style="color:var(--coral-600); font-size:13.5px; margin-bottom:10px;">
                    @errorMessage
                </p>
            }

            <div class="field">
                <label class="field__label" for="rp-new">Новий пароль</label>
                <div class="input-wrap">
                    <input class="input input--with-icon" id="rp-new"
                           type="@(showNewPassword ? "text" : "password")"
                           placeholder="Введіть новий пароль"
                           @bind="newPassword" @bind:event="oninput" />
                    <button type="button" class="input-icon-btn"
                            @onclick="() => showNewPassword = !showNewPassword">
                        <svg class="icon icon--sm" viewBox="0 0 24 24">
                            <path d="M1 12s4-7.5 11-7.5S23 12 23 12s-4 7.5-11 7.5S1 12 1 12z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                    </button>
                </div>
            </div>

            <div class="field">
                <label class="field__label" for="rp-confirm">Повторіть новий пароль</label>
                <div class="input-wrap">
                    <input class="input input--with-icon" id="rp-confirm"
                           type="@(showConfirmPassword ? "text" : "password")"
                           placeholder="Повторіть пароль"
                           @bind="confirmPassword" @bind:event="oninput" />
                    <button type="button" class="input-icon-btn"
                            @onclick="() => showConfirmPassword = !showConfirmPassword">
                        <svg class="icon icon--sm" viewBox="0 0 24 24">
                            <path d="M1 12s4-7.5 11-7.5S23 12 23 12s-4 7.5-11 7.5S1 12 1 12z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                    </button>
                </div>
            </div>

            <button type="button" class="btn btn--primary btn--block"
                    style="margin-top:6px;"
                    disabled="@(isProcessing || string.IsNullOrEmpty(newPassword) || string.IsNullOrEmpty(confirmPassword))"
                    @onclick="HandlePasswordSubmit">
                @(isProcessing ? "Збереження..." : "Змінити пароль")
            </button>
        } *@
    </div>
</div>

@code {
    private int step = 1;
    private bool isProcessing = false;
    private string errorMessage = string.Empty;
    private ElementReference[] inputRefs = new ElementReference[6];
    private string[] digits = Enumerable.Repeat(string.Empty, 6).ToArray();
    private int cooldown = 30;
    private System.Timers.Timer? timer;

    private RPEnterEmailModel model = new();

    private void Close()
    {
        UiState.Show(Modal.None);
    }

    private void HandleEmailSubmit()
    {
        step = 2;
    }

    private void ShowLogin()
    {
        UiState.Show(Modal.Login);
	}

    private void StartCooldown()
    {
        cooldown = 30;
        timer?.Dispose();
        timer = new System.Timers.Timer(1000);
        timer.Elapsed += async (_, _) =>
        {
            if (cooldown > 0)
            {
                cooldown--;
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                timer.Stop();
            }
        };
        timer.Start();
    }

    private async Task HandleNumberInput(int index, ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? "";
        var onlyDigits = new string(value.Where(char.IsDigit).ToArray());

        if (string.IsNullOrEmpty(onlyDigits))
        {
            digits[index] = string.Empty;
            return;
        }

        if (onlyDigits.Length > 1)
        {
            for (int i = 0; i < onlyDigits.Length && i < 6; i++)
            {
                digits[i] = onlyDigits[i].ToString();
            }

            var nextIndex = Math.Min(onlyDigits.Length, 5);

            await inputRefs[nextIndex].FocusAsync();

            if (digits.All(d => d != "")) await HandleCodeSubmit();
            return;
        }

        digits[index] = onlyDigits;

        if (digits[index] != "" && index < 5)
            await inputRefs[index + 1].FocusAsync();

        if (digits.All(d => d != ""))
            await HandleCodeSubmit();
    }

    private async Task HandleKeyDown(int index, KeyboardEventArgs e)
    {
        if (e.Key == "Backspace")
        {
            if (digits[index] != "")
            {
                digits[index] = string.Empty;
            }
            else if (index > 0)
            {
                digits[index - 1] = string.Empty;
                await inputRefs[index - 1].FocusAsync();
            }
        }
    }

    private async Task ResentCode()
    {
        if (cooldown <= 0)
        {
            try
            {
                errorMessage = await JS.InvokeAsync<string>("RPResentCode",
                new ResentRequest
                {
                    Email = UiState.PendingEmail!
                });
                StartCooldown();
            }
            catch
            {
                errorMessage = "Помилка. Спробуйте ще раз.";
            }
        }
    }

    private async Task HandleCodeSubmit()
    {
        if (isProcessing) return;
        if (digits.Any(d => string.IsNullOrWhiteSpace(d))) return;
        errorMessage = string.Empty;
        isProcessing = true;

        var request = new VerifyRequest
        {
            Email = model.Email,
            VerificationCode = string.Concat(digits)
        };

        try
        {
            // errorMessage = await JS.InvokeAsync<string>("verifyUser", request);
			step = 3;
        }
        catch
        {
            errorMessage = "";
        }

        if (string.IsNullOrEmpty(errorMessage))
        {
            UiState.Show(Modal.None);
        }
        isProcessing = false;
    }

    public void Dispose() => timer?.Dispose();
}
